# -----------------------------------------------
# MQTT Broker
# -----------------------------------------------
MQTT_HOST=10.1.1.100
MQTT_PORT=1883
MQTT_USER=smarthome
MQTT_PASS=changeme
MQTT_TOPIC_BASE=bosch-dishwasher
MQTT_KEEPALIVE=60

# -----------------------------------------------
# Bosch Cloud Login (nur beim ersten Start nötig)
# -----------------------------------------------
BOSCH_EMAIL=your@email.com
BOSCH_PASSWORD=changeme

# -----------------------------------------------
# Application
# -----------------------------------------------
LOG_LEVEL=INFO
DATA_HOSTNAME=Docker App
HEARTBEAT_TIME=60

# -----------------------------------------------
# Home Assistant Discovery
# -----------------------------------------------
HA_DISCOVERY=true
HA_DISCOVERY_PREFIX=homeassistant

# -----------------------------------------------
# Dashboard
# -----------------------------------------------
DASHBOARD_PORT=5021
DASHBOARD_LIVE_DAYS=14

# Forecast Basiswerte (100% = Maximalverbrauch des Geräts)
# Anpassen an dein Modell (Datenblatt oder echte Messwerte)
FORECAST_ENERGY_MAX_KWH=1.05
FORECAST_WATER_MAX_L=13.0

# -----------------------------------------------
# Sensoren (optional, fuer echten Verbrauch)
# -----------------------------------------------
# SENSOR_WATER_URL=http://atom-watermeter.local/text_sensor/watermeterdata
# SENSOR_ENERGY_URL=http://10.1.1.100/cm?cmnd=STATUS+8

# -----------------------------------------------
# Home Assistant Webhook (optional)
# Sendet Session-Daten bei Spülgang-Ende an HA
# Beide Variablen muessen gesetzt sein damit der Webhook aktiv ist
# -----------------------------------------------
# HA_WEBHOOK_URL=http://10.1.1.100:8123
# HA_WEBHOOK_ID=bosch_dishwasher

# -----------------------------------------------
# Simulation (optional)
# true = nächsten echten Spülgang aufzeichnen
# false = normal (Standard)
# Abspielen mit: make simulate
# -----------------------------------------------
SIMULATE_RECORD=false
