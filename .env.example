# -----------------------------------------------
# MQTT Broker
# -----------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC_BASE=bosch-dishwasher
MQTT_KEEPALIVE=60
MQTT_HOST=disabled

# -----------------------------------------------
# Bosch Cloud Login (nur beim ersten Start nötig)
# -----------------------------------------------
BOSCH_EMAIL=
BOSCH_PASSWORD=

# -----------------------------------------------
# Application
# -----------------------------------------------
LOG_LEVEL=INFO
LOG_MODE=console
LOG_FILE=logs/app.log
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=3

DATA_HOSTNAME=Docker App
HEARTBEAT_TIME=60

# -----------------------------------------------
# Home Assistant Discovery
# -----------------------------------------------
HA_DISCOVERY=true
HA_DISCOVERY_PREFIX=homeassistant

# -----------------------------------------------
# Dashboard
# -----------------------------------------------
DASHBOARD_PORT=5021
DASHBOARD_LIVE_DAYS=14

# Forecast Basiswerte (100% = Maximalverbrauch des Geräts)
# Bosch SMV4HCX48E: 1.05 kWh / 13 L
FORECAST_WATER_MAX_L=22
FORECAST_ENERGY_MAX_KWH=1.30

# -----------------------------------------------
# Sensoren (optional, für echten Verbrauch)
# WATER:    ESPHOME APP
# ENERGY:   TASMOTA DEVICE
# -----------------------------------------------
SENSOR_WATER_URL=http://<ip>/sensor/wasseruhr_anzeige
SENSOR_ENERGY_URL=http://<ip>/cm?cmnd=STATUS+8

# -----------------------------------------------
# Home Assistant Webhook (optional)
# Sendet Session-Daten bei Spülgang-Ende an HA
# -----------------------------------------------
HA_WEBHOOK_URL=http://<ip>:8123
HA_WEBHOOK_ID=bosch_dishwasher

# -----------------------------------------------
# Simulation (optional)
# true = nächsten echten Spülgang aufzeichnen
# false = normal (Standard)
# Abspielen mit: make simulate
# -----------------------------------------------
SIMULATE_RECORD=true

# -----------------------------------------------
# Session CSV (für Replay-Player)
# -----------------------------------------------
SAVE_SESSIONS=true
SESSIONS_DIR=./data/sessions
SESSIONS_KEEP=10
